# ============================================================
# YaNa Kiosk - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- DATABASE ---
# For local development (SQLite):
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# For production on Vercel (PostgreSQL - get from neon.tech free):
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- AUTHENTICATION ---
# Change this to a long random string in production!
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Admin credentials (used for seeding)
ADMIN_EMAIL="admin@yanakiosk.de"
ADMIN_PASSWORD="YourStrongPassword123!"

# --- STORE INFO ---
NEXT_PUBLIC_STORE_NAME="YaNa Kiosk"
NEXT_PUBLIC_STORE_ADDRESS="Barsbütteler Hof 2c, 22885 Barsbüttel"
NEXT_PUBLIC_STORE_PHONE="040 6704066"
NEXT_PUBLIC_STORE_EMAIL="yana-kiosk@web.de"
